# PaperViz environment configuration.
# Copy to .env and fill in real values. .env is gitignored — never commit real
# secrets.
#
# PaperViz holds no model vendor account: users bring their own model key
# through the web UI, encrypted at rest with CREDENTIAL_ENCRYPTION_KEY.
#
# Identity is handled by Clerk, which means PaperViz does hold one third-party
# account — for authentication only. Model access and billing remain BYOK. See
# docs/DECISIONS/ADR-003-clerk-auth.md for why that trade was accepted.

# Required. 32 random bytes, base64-encoded. Encrypts stored user model keys
# (AES-256-GCM). Losing or rotating it makes every stored key unreadable, so it
# is the one variable the server refuses to boot without.
#   Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Required. Clerk API secret key (sk_live_... or sk_test_...). Verifies the
# session token on every authenticated request and resolves an account's email
# the first time it is seen. The server refuses to boot without it, because a
# wrong key makes every login fail while /healthz still reports ok.
CLERK_SECRET_KEY=

# Required for the frontend build. Clerk publishable key (pk_live_... or
# pk_test_...). Safe to ship to the browser; it grants no server-side access.
# Vite inlines VITE_* at build time, so this must be set when `npm run build`
# runs, not only at runtime.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional. Defaults to true. Set false to refuse document creation with 503
# while leaving read, share, and library paths working. The panic button for an
# abuse spike or a runaway queue, and it needs no deploy.
# INGESTION_ENABLED=true

# Optional. How many documents may process at once. Defaults to 2. Bounds our
# CPU, not model spend: under BYOK the model bill belongs to the user, but PDF
# extraction, chart generation, and SQLite writes are ours. SQLite runs on a
# single connection, so unbounded pipelines degrade the whole service.
# PIPELINE_MAX_CONCURRENCY=2

# Optional. Path to the SQLite database file. Defaults to paperviz.db in the
# working directory.
DATABASE_PATH=paperviz.db

# Optional. Directory of built frontend assets, served by the Go binary in
# production. Defaults to frontend/dist.
STATIC_DIR=frontend/dist

# Optional. HTTP port. Defaults to 8080.
PORT=8080

# Optional. Log file path. Defaults to paperviz.log.jsonl.
# LOG_FILE=paperviz.log.jsonl

# Optional. Whether the session cookie carries the Secure attribute. Defaults
# to true, which is correct for any HTTPS deployment.
#
# Set it to false ONLY for local plain-HTTP development. A Secure cookie sent
# over http:// is dropped by the browser, so login appears to succeed and every
# later request 401s. It stays an explicit flag rather than a check of r.TLS
# because a reverse proxy terminates TLS and forwards plain HTTP to the origin,
# so r.TLS is nil in production too.
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Optional. Supabase Storage for chart images. When all three are set, chart
# image bytes are written to object storage instead of the charts.image_blob
# column, which keeps the SQLite file from growing with figures. Leaving them
# unset is fully supported and stores images in the database as before.
#
# The bucket must be PRIVATE. Chart images can expose a figure from a paper the
# user has not shared, so every read is authorized with the secret key.
#
# SECRET_KEY_SUPABASE is a service-role style key. Never ship it to a browser.
# ---------------------------------------------------------------------------
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_STORAGE_BUCKET=chart-images
# SECRET_KEY_SUPABASE=sb_secret_...

# ---------------------------------------------------------------------------
# Read by cmd/mcp only. It runs on the user's own machine and calls the model
# provider directly, so it needs no credential from us. The web server ignores
# all of these.
# ---------------------------------------------------------------------------

# Required by cmd/mcp. Get a key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Optional, cmd/mcp. Defaults to gemini-2.5-flash-lite.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Required by cmd/mcp. The per-process key that MCP clients authenticate with.
# Any high-entropy string; it is not stored and is never returned by the API.
# PAPERVIZ_API_KEY=

# Optional, cmd/admin and cmd/mcp. Defaults to "migrations" relative to the
# working directory.
# MIGRATIONS_DIR=migrations
