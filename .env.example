# PaperViz environment configuration.
# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets (ARCHITECTURE.md Section 5: "Gemini API key
# MUST be loaded from environment variable only. PROHIBITED: hardcoded
# keys, keys in config files committed to repo.")

# Required. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash if unset (see cmd/server/main.go).
# Valid stable models: gemini-3.5-flash, gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional. Path to the SQLite database file. Defaults to paperviz.db in
# the working directory.
DATABASE_PATH=paperviz.db

# Optional. Directory of the built frontend assets, served by the Go
# binary in production. Defaults to frontend/dist.
STATIC_DIR=frontend/dist

# Optional. HTTP port. Defaults to 8080.
PORT=8080

# Required. Google OAuth for one-click login (fail-loud at startup per Chunk 12.2).
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Required. Stripe for subscription billing (fail-loud at startup per Chunk 12.2).
# Get credentials from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_RESEARCH=
FRONTEND_URL=http://localhost:5173
