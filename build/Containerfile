# Go API image. Identical in purpose to Containerfile.backend — the SPA is
# built and served separately (Cloudflare Pages), so there is no node stage and
# no frontend assets in the runtime layer.
# Stage 1 — Build Go server
FROM docker.io/golang:1.25-alpine AS backend
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /server ./cmd/server

# Stage 2 — Runtime (3.3 MB + binary = ~20 MB)
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
RUN adduser -D -h /app paperviz
COPY --from=backend /server /app/server
# Migrations are read from disk at startup, not embedded in the binary. Without
# this the server exits before binding a port.
COPY --from=backend /build/migrations /app/migrations
# The database path is set per-deployment (Render mounts a disk, or the
# ephemeral filesystem is used). Create it up front and hand it to the
# non-root runtime user, or the first query fails on permissions.
RUN mkdir -p /data && chown paperviz:paperviz /data
WORKDIR /app
USER paperviz
ENV DATABASE_PATH=/data/paperviz.db \
    MIGRATIONS_DIR=/app/migrations
EXPOSE 8080
CMD ["/app/server"]
