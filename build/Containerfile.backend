# Backend-only image — Go binary serving API + embedded frontend
# Used for: production deployment, API server, full-stack single-binary
FROM docker.io/golang:1.25-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
RUN adduser -D -h /app paperviz
COPY --from=builder /server /app/server
WORKDIR /app
USER paperviz
EXPOSE 8080
CMD ["/app/server"]
